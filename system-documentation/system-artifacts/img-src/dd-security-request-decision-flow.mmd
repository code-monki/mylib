flowchart TB
  subgraph Diagram["HLA-SECURITY request decision flow"]
    direction TB
    Request["Protected request"]
    Session["Validate session"]
    Principal["Resolve principal and tenant context"]
    Policy["Evaluate RBAC and tenant policy"]
    Decision{"Authorized?"}
    Domain["Domain service executes"]
    Deny["Reject before domain service"]
    Audit["Emit audit event when required"]
    Obs["Emit minimized diagnostic event when needed"]

    Request --> Session
    Session --> Principal
    Principal --> Policy
    Policy --> Decision
    Decision -->|yes| Domain
    Decision -->|no| Deny
    Decision -->|if required| Audit
    Deny --> Obs
  end
  style Diagram fill:#ffffff,stroke:#ffffff,color:#111111
